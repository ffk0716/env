#!/usr/bin/env python3
import os
import re
from pathlib import Path


def rename_crf_files(dry_run: bool = True):
    path = Path('.')

    file_pattern = "**/*"
    matched_files = []
    for f in path.glob(file_pattern):
        if not f.is_file():
            continue
        if '.mp4' in f.name.lower() or '.mov' in f.name.lower():
            if 'crf' in f.name.lower():
                matched_files.append(f)

    if not matched_files:
        print("未找到包含 'crf' 的 .mp4 檔案。")
        return

    print(f"找到 {len(matched_files)} 個符合條件的檔案 {'[預覽模式 - 不會修改檔案]' if dry_run else '[正式執行更名]'}:\n")

    count = 0
    for file_path in matched_files:
        old_name = file_path.name

        new_name = re.sub(r"\.crf\d+\.", ".enc.", old_name, flags=re.IGNORECASE)
        new_name = re.sub(r"\.nre\.", ".org.", new_name , flags=re.IGNORECASE)

        if old_name != new_name:
            new_path = file_path.with_name(new_name)

            if new_path.exists():
                print(f"[略過] 目標檔案已存在: {new_path}")
                continue

            if dry_run:
                print(f"[模擬] {old_name} -> {new_name}")
            else:
                try:
                    file_path.rename(new_path)
                    print(f"[完成] {old_name} -> {new_name}")
                    count += 1
                except Exception as e:
                    print(f"[失敗] 無法更名 {old_name}: {e}")

    if not dry_run:
        print(f"\n全部處理完成，共更名 {count} 個檔案。")
    else:
        print("\n確認無誤後，請將腳本中的 `dry_run = False` 即可正式執行。")


if __name__ == "__main__":

    DRY_RUN = True
    DRY_RUN = False

    rename_crf_files(dry_run=DRY_RUN)
